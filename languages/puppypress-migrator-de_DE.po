msgid "Sidebar \"%s\" does not exist in the active theme; its widgets were added to the inactive widgets."
msgstr "Die Sidebar „%s“ gibt es im aktiven Theme nicht; ihre Widgets wurden zu den inaktiven Widgets hinzugefügt."

#. translators: %d: number of widgets
#: includes/Importer.php:1202
msgid "%d widgets imported."
msgstr "%d Widgets importiert."

