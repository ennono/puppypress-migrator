msgstr "Mediendateien: %1$d heruntergeladen, %2$d aus dem Paket entpackt, %3$d bereits vorhanden."

#: includes/Importer.php:274
msgid "not readable in the package"
msgstr "im Paket nicht lesbar"

#. translators: 1: file path, 2: reason
#: includes/Importer.php:312
msgid "Media file not transferred (%2$s): %1$s"
msgstr "Mediendatei nicht übertragen (%2$s): %1$s"

#: includes/Importer.php:314
msgid "Further failed files are only counted."
msgstr "Weitere fehlgeschlagene Dateien werden nur gezählt."

#. translators: 1: term name, 2: error message
#: includes/Importer.php:369
