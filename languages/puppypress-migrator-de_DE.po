msgstr "%d Mediendateien wurden wegen ihres Dateityps oder Namens nicht übertragen (siehe oben)."

#. translators: %d: number of files
#: includes/Exporter.php:582
msgid "Only the first %d of these files are listed individually."
msgstr "Nur die ersten %d dieser Dateien werden einzeln aufgeführt."

#: includes/Importer.php:101
msgid "This is not a PuppyPress migration package (data.json is missing)."
msgstr "Dies ist kein PuppyPress-Migrationspaket (data.json fehlt)."

#: includes/Importer.php:107
