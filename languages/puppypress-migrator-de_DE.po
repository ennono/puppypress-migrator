#. Plugin Name of the plugin
#: puppypress-migrator.php
msgid "PuppyPress Migrator"
msgstr "PuppyPress Migrator"

#. Description of the plugin
#: puppypress-migrator.php
msgid "Exports all club data (stud dogs, litters, kennels, pedigrees, media, menus, widgets …) from a site running the former \"Extra Child\" theme and imports it into a site running PuppyPress, including remapping of all IDs."
msgstr "Exportiert alle Vereinsdaten (Deckrüden, Würfe, Zwinger, Abstammungen, Medien, Menüs, Widgets …) aus einer Website mit dem bisherigen Theme „Extra Child“ und importiert sie in eine Website mit PuppyPress, inklusive Umschreiben aller IDs."

#. Author of the plugin
#: puppypress-migrator.php
msgid "Timo Fricke"
msgstr "Timo Fricke"
