msgid "could not be saved"
msgstr "konnte nicht gespeichert werden"

#: includes/Exporter.php:73 includes/Importer.php:94
msgid "The PHP extension \"zip\" (ZipArchive) is required."
msgstr "Die PHP-Erweiterung „zip“ (ZipArchive) wird benötigt."

#. translators: %s: technical error message
#: includes/Exporter.php:94
msgid "The data could not be encoded: %s"
msgstr "Die Daten konnten nicht kodiert werden: %s"

#: includes/Exporter.php:99
msgid "The ZIP file could not be created."
msgstr "Die ZIP-Datei konnte nicht erstellt werden."

#. translators: 1: number, 2: post type
#: includes/Exporter.php:117
