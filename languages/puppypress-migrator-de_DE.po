msgstr "%d Verweise zeigten auf Inhalte, die nicht im Paket enthalten sind, und wurden entfernt."

#: includes/Importer.php:841
msgid "The job data is incomplete. Please start the import again."
msgstr "Die Vorgangsdaten sind unvollständig. Bitte starten Sie den Import erneut."

#. translators: 1: user login, 2: error message
#: includes/Importer.php:979
msgid "User \"%1$s\" could not be created: %2$s"
msgstr "Benutzer „%1$s“ konnte nicht angelegt werden: %2$s"

#. translators: 1: user login, 2: role
#: includes/Importer.php:985
msgid "User \"%1$s\" created (role: %2$s, random password)."
msgstr "Benutzer „%1$s“ angelegt (Rolle: %2$s, zufälliges Passwort)."

#. translators: %d: number of files
#: includes/Importer.php:1115
msgid "%d files in the package have a forbidden name or type and are ignored."
msgstr "%d Dateien im Paket haben einen unzulässigen Namen oder Typ und werden ignoriert."

#. translators: %d: number of files
#: includes/Importer.php:1120
msgid "%d media files are neither in the package nor marked for download and are skipped."
msgstr "%d Mediendateien sind weder im Paket noch zum Herunterladen vorgesehen und werden übersprungen."

#. translators: 1: number of files, 2: URL
#: includes/Importer.php:1125
msgid "%1$d media files will be downloaded from %2$s."
msgstr "%1$d Mediendateien werden von %2$s heruntergeladen."

#. translators: %s: sidebar ID
