msgstr "%1$d × %2$s"

#. translators: 1: number of terms, 2: number of comments, 3: number of media files, 4: size
#: includes/Exporter.php:121
msgid "%1$d terms, %2$d comments, %3$d media files (%4$s)."
msgstr "%1$d Begriffe, %2$d Kommentare, %3$d Mediendateien (%4$s)."

#: includes/Exporter.php:126
msgid "Media files are not packed. The import downloads them from this site, so it must stay online until the import is finished. Files that were already copied to the new site (e.g. via FTP or rsync) are only checked."
msgstr "Mediendateien werden nicht gepackt. Der Import lädt sie von dieser Website herunter; sie muss deshalb bis zum Ende des Imports erreichbar bleiben. Dateien, die schon auf die neue Website kopiert wurden (z. B. per FTP oder rsync), werden nur geprüft."

#. translators: %d: number of files
#: includes/Exporter.php:129
msgid "Packing %d files into one ZIP takes long and needs a lot of disk space. If the export stops, choose \"Download during import\" instead."
msgstr "%d Dateien in ein ZIP zu packen dauert lange und braucht viel Speicherplatz. Falls der Export abbricht, wählen Sie stattdessen „Beim Import herunterladen“."

#: includes/Exporter.php:156 includes/Importer.php:820
msgid "The ZIP file could not be opened."
msgstr "Die ZIP-Datei konnte nicht geöffnet werden."

#. translators: %s: file size
#: includes/Exporter.php:189
msgid "Export finished (%s)."
msgstr "Export abgeschlossen (%s)."

#. translators: %s: file path
#: includes/Exporter.php:554
msgid "File is missing on the server: %s"
msgstr "Datei fehlt auf dem Server: %s"

#. translators: 1: file path, 2: reason
#: includes/Exporter.php:557
msgid "Not transferred (%2$s): %1$s"
msgstr "Nicht übertragen (%2$s): %1$s"

#. translators: %d: number of files
#: includes/Exporter.php:571
msgid "%d media library entries point to files that do not exist on the server (deleted, moved or stored externally)."
msgstr "%d Einträge der Mediathek verweisen auf Dateien, die es auf dem Server nicht gibt (gelöscht, verschoben oder extern gespeichert)."

#. translators: %d: number of files
#: includes/Exporter.php:576
